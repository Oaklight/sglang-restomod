+def _system_has_openssl_headers() -> bool:
+    return os.path.exists("/usr/include/openssl/sha.h")
+
+
+def _local_openssl_build_flags() -> tuple[list[str], list[str]]:
+    """Find OpenSSL in the interpreter's own prefix, as a conda env has it.
+
+    The CUDA base images ship the OpenSSL runtime but not the development
+    files, so `<openssl/sha.h>` is missing and `-lcrypto` has no unversioned
+    library to resolve against; the JIT build of `hash_binding.cpp` then fails
+    and every HiCache storage backend is unusable. A conda-style prefix
+    carries both. Link the library by path so the linker records its SONAME,
+    which the image's runtime copy also provides.
+    """
+    cflags: list[str] = []
+    ldflags: list[str] = []
+    include_dir = os.path.join(sys.prefix, "include")
+    if os.path.exists(os.path.join(include_dir, "openssl", "sha.h")):
+        cflags.append(f"-I{include_dir}")
+    for name in ("libcrypto.so", "libcrypto.dylib"):
+        candidate = os.path.join(sys.prefix, "lib", name)
+        if os.path.exists(candidate):
+            ldflags.append(candidate)
+            break
+    return cflags, ldflags
+
+
