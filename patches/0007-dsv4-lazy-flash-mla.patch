         raise NotImplementedError(f"unsupported {forward_mode=}")
 
 
+def resolve_flash_mla(swa_interleaved: bool):
+    """Bind ``flash_mla_with_kvcache`` for this platform, or a named refusal.
+
+    flash_mla is built for the architectures it targets and for no others, so
+    the import lives here rather than in ``__init__``: on a platform without
+    it the backend must still be constructible, and the failure must arrive at
+    the call that would use flash_mla, naming the reason, rather than as a
+    ``ModuleNotFoundError`` while the backend is being built.
+
+    Returns ``(callable, split_kv_min_topk)``.
+    """
+    try:
+        from sglang.kernels.ops.attention import flash_mla_interface
+    except ImportError:
+
+        def _flash_mla_unavailable(*_args, **_kwargs):
+            raise RuntimeError(
+                "flash_mla is not available on this platform; the DSV4 "
+                "attention path that calls it cannot run here. Use a backend "
+                "that does not depend on flash_mla."
+            )
+
+        return _flash_mla_unavailable, 0
+
+    return (
+        functools.partial(
+            flash_mla_interface.flash_mla_with_kvcache,
+            use_legacy=not swa_interleaved,
+        ),
+        flash_mla_interface.SPLIT_KV_MIN_TOPK,
+    )
+
+
