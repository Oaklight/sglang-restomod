diff --git a/CMakeLists.txt b/CMakeLists.txt
index b4d9dbf..49e887c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -130,6 +130,27 @@ if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.8)
 endif()
 list(APPEND MARLIN_V100_MOE_SRC "${MARLIN_MOE_OTHER_SRC}")

+# Build only the quantized families used by this SGLang fork.
+option(MARLIN_V100_NVFP4_ONLY "Build the reduced NVFP4 serving profile" OFF)
+option(MARLIN_V100_FP8 "Include weight-only FP8 in the reduced serving build" OFF)
+if(MARLIN_V100_NVFP4_ONLY)
+  set(MARLIN_V100_DENSE_SRC
+    "csrc/torch_bindings_marlin.cpp"
+    "csrc/quantization/marlin/gptq_marlin_repack.cu")
+  set(MARLIN_V100_MOE_SRC
+    "csrc/moe/torch_bindings_marlin.cpp"
+    "csrc/moe/moe_align_sum_kernels.cu"
+    "csrc/moe/topk_softmax_kernels.cu"
+    "csrc/moe/grouped_topk_kernels.cu"
+    "csrc/quantization/marlin/sm70_marlin_bias.cu"
+    "csrc/moe/marlin_moe_wna16/ops.cu"
+    "csrc/moe/marlin_moe_wna16/sm70_marlin_nvfp4_gemm.cu")
+  if(MARLIN_V100_FP8)
+    list(APPEND MARLIN_V100_MOE_SRC
+      "csrc/moe/marlin_moe_wna16/sm70_marlin_fp8_gemm.cu")
+  endif()
+endif()
+
 define_extension_target(
   _C
   DESTINATION vllm
@@ -151,3 +172,10 @@ define_extension_target(
   ARCHITECTURES ${VLLM_GPU_ARCHES}
   USE_SABI 3
   WITH_SOABI)
+
+if(MARLIN_V100_NVFP4_ONLY)
+  target_compile_definitions(_moe_C PRIVATE MARLIN_V100_NVFP4_ONLY)
+endif()
+if(MARLIN_V100_FP8)
+  target_compile_definitions(_moe_C PRIVATE MARLIN_V100_FP8)
+endif()
diff --git a/csrc/moe/marlin_moe_wna16/ops.cu b/csrc/moe/marlin_moe_wna16/ops.cu
index e289b43..89692a6 100644
--- a/csrc/moe/marlin_moe_wna16/ops.cu
+++ b/csrc/moe/marlin_moe_wna16/ops.cu
@@ -400,6 +400,7 @@ torch::Tensor moe_wna16_marlin_gemm(
         a.scalar_type() == c.scalar_type(),
         "scalar type of a must be the same with c for 16 bit activation");
   }
+#if !defined(MARLIN_V100_NVFP4_ONLY)
   if (b_type == vllm::kU4) {
     TORCH_CHECK(has_zp && is_zp_float,
                 "SM70 Marlin MoE uint4 path requires fp16 zero points.");
@@ -462,6 +463,8 @@ torch::Tensor moe_wna16_marlin_gemm(
         mul_topk_weights, size_m, size_n, size_k, group_size);
   }

+#endif
+#if !defined(MARLIN_V100_NVFP4_ONLY) || defined(MARLIN_V100_FP8)
   if (b_type == vllm::kFE4M3fn) {
     TORCH_CHECK(group_size == -1 || group_size == 128,
                 "SM70 Marlin MoE fp8_e4m3 supports only group_size -1 or "
@@ -482,6 +485,7 @@ torch::Tensor moe_wna16_marlin_gemm(
         mul_topk_weights, size_m, size_n, size_k, group_size);
   }

+#endif
   if (b_type == vllm::kFE2M1f) {
     TORCH_CHECK(!has_zp && !is_zp_float,
                 "SM70 Marlin MoE fp4 does not support zero-point metadata.");
@@ -506,6 +510,7 @@ torch::Tensor moe_wna16_marlin_gemm(
           group_size);
     }

+#if !defined(MARLIN_V100_NVFP4_ONLY)
     TORCH_CHECK(s_type == vllm::kFE8M0fnu,
                 "SM70 Marlin MoE mxfp4 expects float8_e8m0fnu scales.");
     TORCH_CHECK(group_size == 32,
@@ -522,6 +527,9 @@ torch::Tensor moe_wna16_marlin_gemm(
         a, c, b_q_weight, b_scales, b_bias, sorted_token_ids, expert_ids,
         num_tokens_past_padded, topk_weights, moe_block_size, top_k,
         mul_topk_weights, size_m, size_n, size_k, group_size);
+#else
+    TORCH_CHECK(false, "This reduced build supports NVFP4 and optional FP8 only.");
+#endif
   }

   TORCH_CHECK(false, "Unsupported SM70 Marlin MoE weight type.");
