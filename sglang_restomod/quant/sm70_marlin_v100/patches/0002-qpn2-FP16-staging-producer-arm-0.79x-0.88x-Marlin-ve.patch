diff --git a/tests/qpn2_repack_model.h b/tests/qpn2_repack_model.h
new file mode 100644
index 0000000..48b4384
--- /dev/null
+++ b/tests/qpn2_repack_model.h
@@ -0,0 +1,63 @@
+#pragma once
+
+// Host model of the QPN2 repack (spec section 4). Tests only; the real repack
+// is the loader-side kernel. The address is the section-1 address
+// (t*groups+g)*288 + lane*8 + byte, NOT the flat code-byte index i from the
+// section-4 pseudocode: the two differ from the second group onward because
+// each group carries 32 scale bytes.
+
+#include <cstdint>
+#include <vector>
+
+#include "quantization/marlin/qpn2_layout.cuh"
+
+namespace qpn2_test {
+
+struct Packed {
+  std::vector<uint8_t> bytes;
+  int tiles;
+  int groups;
+};
+
+inline Packed repack(const std::vector<uint8_t>& weight,
+                     const std::vector<uint8_t>& scales, int n, int k) {
+  namespace q = marlin::sm70::qpn2;
+  Packed packed;
+  packed.tiles = (n + q::kColsPerTile - 1) / q::kColsPerTile;
+  packed.groups = k / q::kKPerGroup;
+  packed.bytes.assign(static_cast<size_t>(packed.tiles * packed.groups) * q::kGroupBytes, 0);
+  const int k_bytes = k / 2;
+  const int64_t code_count =
+      static_cast<int64_t>(packed.tiles) * packed.groups * q::kLanes * 8;
+  for (int64_t i = 0; i < code_count; ++i) {
+    const int physical_byte = static_cast<int>(i & 7);
+    int64_t outer = i >> 3;
+    const int lane = static_cast<int>(outer & 31);
+    outer >>= 5;
+    const int g = static_cast<int>(outer % packed.groups);
+    const int t = static_cast<int>(outer / packed.groups);
+    const int column = t * q::kColsPerTile + q::col_from_lane(lane);
+    const int k0 = g * q::kKPerGroup + q::logical_k(2 * physical_byte);
+    const int k1 = g * q::kKPerGroup + q::logical_k(2 * physical_byte + 1);
+    uint8_t c0 = 0, c1 = 0;
+    if (column < n) {
+      c0 = (weight[static_cast<size_t>(column) * k_bytes + k0 / 2] >> ((k0 & 1) * 4)) & 0xF;
+      c1 = (weight[static_cast<size_t>(column) * k_bytes + k1 / 2] >> ((k1 & 1) * 4)) & 0xF;
+    }
+    const int64_t off = (static_cast<int64_t>(t) * packed.groups + g) * q::kGroupBytes +
+                        lane * 8 + physical_byte;
+    packed.bytes[off] = static_cast<uint8_t>(c0 | (c1 << 4));
+  }
+  for (int64_t i = 0; i < static_cast<int64_t>(packed.tiles) * packed.groups; ++i) {
+    const int g = static_cast<int>(i % packed.groups);
+    const int t = static_cast<int>(i / packed.groups);
+    for (int lane = 0; lane < q::kLanes; ++lane) {
+      const int column = t * q::kColsPerTile + q::col_from_lane(lane);
+      packed.bytes[static_cast<size_t>(i) * q::kGroupBytes + q::kScaleOffset + lane] =
+          column < n ? scales[static_cast<size_t>(column) * packed.groups + g] : 0;
+    }
+  }
+  return packed;
+}
+
+}  // namespace qpn2_test
diff --git a/tests/qpn2_transpose_probe.cu b/tests/qpn2_transpose_probe.cu
new file mode 100644
index 0000000..33e2938
--- /dev/null
+++ b/tests/qpn2_transpose_probe.cu
@@ -0,0 +1,385 @@
+// QPN2 prefill reader probe: warp transpose, shared-layout store, and K pairing.
+//
+// Build on an SM70 host with CUTLASS on the include path:
+//   nvcc -std=c++17 -O2 -arch=sm_70 -Icsrc -Itests -I<cutlass>/include \
+//     tests/qpn2_transpose_probe.cu -o /tmp/qpn2_transpose_probe
+//
+// Usage: --smoke (all), --transpose, --store, --korder, --gemm
+
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#include "cutlass/layout/tensor_op_multiplicand_sm70.h"
+#include "quantization/marlin/qpn2_layout.cuh"
+#include "qpn2_repack_model.h"
+
+namespace q = marlin::sm70::qpn2;
+
+constexpr int kCtaK = 32;
+constexpr int kCtaN = 64;
+constexpr int kThreads = 128;  // 4 warps
+constexpr int kM = 8;
+
+#define CUDA_CHECK(call)                                                     \
+  do {                                                                       \
+    cudaError_t s = (call);                                                  \
+    if (s != cudaSuccess) {                                                  \
+      std::printf("CUDA error %s at %s:%d\n", cudaGetErrorString(s),         \
+                  __FILE__, __LINE__);                                       \
+      return 1;                                                              \
+    }                                                                        \
+  } while (0)
+
+__device__ __forceinline__ void trick_half2(uint32_t w, __half2 out[4]) {
+  const uint32_t kSign = 0x80008000u, kExpMant = 0x0e000e00u;
+  uint32_t v[4];
+  v[0] = ((w << 12) & kSign) | ((w << 9) & kExpMant);
+  v[1] = ((w << 8) & kSign) | ((w << 5) & kExpMant);
+  v[2] = ((w << 4) & kSign) | ((w << 1) & kExpMant);
+  v[3] = (w & kSign) | ((w >> 3) & kExpMant);
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    out[i] = __halves2half2(__ushort_as_half(static_cast<uint16_t>(v[i] & 0xffff)),
+                            __ushort_as_half(static_cast<uint16_t>(v[i] >> 16)));
+  }
+}
+
+// One E4M3 scale byte and the per-expert global scale, one rounding (spec §3).
+__device__ __forceinline__ __half scale_half(uint8_t byte, float global_scale) {
+  const __half h = __ushort_as_half(q::e4m3_to_fp16_bits(byte));
+  const float raw = __half2float(h) * 256.0f;
+  return __float2half_rn(raw * global_scale);
+}
+
+// Reference value path: the same per-value half ops as the reader.
+__device__ __forceinline__ __half dequant_one(uint8_t code, __half scale) {
+  __half2 v[4];
+  trick_half2(static_cast<uint32_t>(code), v);  // code at nibble position 0
+  const __half c = __low2half(v[0]);
+  return __hmul(__hmul(c, __float2half(16384.0f)), scale);
+}
+
+__device__ __forceinline__ uint32_t code_nibble(uint32_t reg, int byte_in_reg,
+                                                int high) {
+  return (reg >> (byte_in_reg * 8 + (high ? 4 : 0))) & 0xf;
+}
+
+// One CTA tile [CtaK, CtaN]. Warp w owns QPN2 group w = (t_local, g_local).
+// Lane l reads storage lane l; after the transpose lane l owns
+// n-block b = l & 3 for k = g*16 + 2*(l>>2) + {0,1}.
+__global__ void transpose_kernel(const uint8_t* __restrict__ qpn2,
+                                 int groups, float global_scale,
+                                 __half* __restrict__ out /* [CtaK][CtaN] */) {
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int warp = tid >> 5;
+  const int t_local = warp >> 1;
+  const int g_local = warp & 1;
+  const int64_t group_off = (static_cast<int64_t>(t_local) * groups + g_local) * q::kGroupBytes;
+  const uint2 codes = *reinterpret_cast<const uint2*>(qpn2 + group_off + lane * 8);
+  const __half my_scale = scale_half(qpn2[group_off + q::kScaleOffset + lane], global_scale);
+
+  const int b = lane & 3;
+  const int q = lane >> 2;  // k pair index within the K16 group
+  static const int kInv[8] = {0, 4, 1, 5, 2, 6, 3, 7};
+
+  // Fetch both code words from every column of this block once. The register
+  // that holds the target nibble depends on the TARGET's k, so a single
+  // source-selected register is wrong: fetch both and select here.
+  uint32_t sx[8], sy[8];
+  __half sc[8];
+#pragma unroll
+  for (int c = 0; c < 8; ++c) {
+    const int src = q::lane_from_col(b * 8 + c);
+    sx[c] = __shfl_sync(0xffffffffu, codes.x, src);
+    sy[c] = __shfl_sync(0xffffffffu, codes.y, src);
+    sc[c] = __ushort_as_half(static_cast<uint16_t>(
+        __shfl_sync(0xffffffffu, __half_as_ushort(my_scale), src)));
+  }
+
+#pragma unroll
+  for (int j = 0; j < 2; ++j) {
+    const int k_local = 2 * q + j;
+    const int p = q::physical_k(k_local);
+    const int byte_in_reg = (p >> 1) & 3;
+    const int high = p & 1;
+    const bool low_word = (p >> 1) < 4;
+
+    uint32_t word = 0;
+    __half scales[8];
+#pragma unroll
+    for (int c = 0; c < 8; ++c) {
+      const uint32_t src_reg = low_word ? sx[c] : sy[c];
+      word |= code_nibble(src_reg, byte_in_reg, high) << (4 * kInv[c]);
+      scales[c] = sc[c];
+    }
+
+    __half2 v[4];
+    trick_half2(word, v);
+    __half2 pairs[4] = {
+        __halves2half2(scales[0], scales[1]),
+        __halves2half2(scales[2], scales[3]),
+        __halves2half2(scales[4], scales[5]),
+        __halves2half2(scales[6], scales[7]),
+    };
+    union {
+      __half h[8];
+      uint4 v;
+    } pack;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      __half2 r = __hmul2(__hmul2(v[i], __float2half2_rn(16384.0f)), pairs[i]);
+      pack.h[2 * i] = __low2half(r);
+      pack.h[2 * i + 1] = __high2half(r);
+    }
+    const int k = g_local * 16 + k_local;
+    const int n0 = t_local * 32 + b * 8;
+    *reinterpret_cast<uint4*>(out + k * kCtaN + n0) = pack.v;
+  }
+}
+
+__global__ void reference_kernel(const uint8_t* __restrict__ qpn2, int groups,
+                                 float global_scale,
+                                 __half* __restrict__ out, int k_total, int n_total) {
+  const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  if (idx >= k_total * n_total) return;
+  const int k = idx / n_total;
+  const int n = idx % n_total;
+  const int tile = n / 32;
+  const int col = n % 32;
+  const int g = k / 16;
+  const int lane = q::lane_from_col(col);
+  const int p = q::physical_k(k % 16);
+  const int64_t off = (static_cast<int64_t>(tile) * groups + g) * q::kGroupBytes;
+  const uint8_t byte = qpn2[off + lane * 8 + (p >> 1)];
+  const uint8_t code = q::nibble_at(byte, p & 1);
+  out[idx] = dequant_one(code, scale_half(qpn2[off + q::kScaleOffset + lane], global_scale));
+}
+
+using LayoutB = cutlass::layout::RowMajorVoltaTensorOpMultiplicandBCongruous<16>;
+
+// Re-run the transpose and store each 8-half word through the shared layout.
+__global__ void store_kernel(const uint8_t* __restrict__ qpn2, int groups,
+                             float global_scale, __half* __restrict__ tile) {
+  const int tid = threadIdx.x;
+  const int lane = tid & 31;
+  const int warp = tid >> 5;
+  const int t_local = warp >> 1;
+  const int g_local = warp & 1;
+  const int64_t group_off = (static_cast<int64_t>(t_local) * groups + g_local) * q::kGroupBytes;
+  const uint2 codes = *reinterpret_cast<const uint2*>(qpn2 + group_off + lane * 8);
+  const __half my_scale = scale_half(qpn2[group_off + q::kScaleOffset + lane], global_scale);
+  const int b = lane & 3;
+  const int q = lane >> 2;
+  static const int kInv[8] = {0, 4, 1, 5, 2, 6, 3, 7};
+  LayoutB layout(kCtaN);
+  uint32_t sx[8], sy[8];
+  __half sc[8];
+#pragma unroll
+  for (int c = 0; c < 8; ++c) {
+    const int src = q::lane_from_col(b * 8 + c);
+    sx[c] = __shfl_sync(0xffffffffu, codes.x, src);
+    sy[c] = __shfl_sync(0xffffffffu, codes.y, src);
+    sc[c] = __ushort_as_half(static_cast<uint16_t>(
+        __shfl_sync(0xffffffffu, __half_as_ushort(my_scale), src)));
+  }
+#pragma unroll
+  for (int j = 0; j < 2; ++j) {
+    const int k_local = 2 * q + j;
+    const int p = q::physical_k(k_local);
+    const int byte_in_reg = (p >> 1) & 3;
+    const int high = p & 1;
+    const bool low_word = (p >> 1) < 4;
+    uint32_t word = 0;
+    __half scales[8];
+#pragma unroll
+    for (int c = 0; c < 8; ++c) {
+      const uint32_t src_reg = low_word ? sx[c] : sy[c];
+      word |= code_nibble(src_reg, byte_in_reg, high) << (4 * kInv[c]);
+      scales[c] = sc[c];
+    }
+    __half2 v[4];
+    trick_half2(word, v);
+    __half2 pairs[4] = {
+        __halves2half2(scales[0], scales[1]), __halves2half2(scales[2], scales[3]),
+        __halves2half2(scales[4], scales[5]), __halves2half2(scales[6], scales[7])};
+    union {
+      __half h[8];
+      uint4 v;
+    } pack;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      __half2 r = __hmul2(__hmul2(v[i], __float2half2_rn(16384.0f)), pairs[i]);
+      pack.h[2 * i] = __low2half(r);
+      pack.h[2 * i + 1] = __high2half(r);
+    }
+    const int k = g_local * 16 + k_local;
+    const int n0 = t_local * 32 + b * 8;
+    const int64_t off = layout(cutlass::MatrixCoord(k, n0));
+    *reinterpret_cast<uint4*>(tile + off) = pack.v;
+  }
+}
+
+__global__ void gemm_kernel(const __half* __restrict__ a, const __half* __restrict__ b,
+                            float* __restrict__ c, int m, int n, int k) {
+  const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+  if (idx >= m * n) return;
+  const int row = idx / n;
+  const int col = idx % n;
+  float acc = 0.0f;
+  for (int kk = 0; kk < k; ++kk) {
+    acc += __half2float(a[row * k + kk]) * __half2float(b[kk * n + col]);
+  }
+  c[idx] = acc;
+}
+
+static void fill_inputs(std::vector<uint8_t>& weight, std::vector<uint8_t>& scales,
+                        int n, int kk) {
+  std::mt19937 rng(20261106);
+  weight.resize(static_cast<size_t>(n) * (kk / 2));
+  scales.resize(static_cast<size_t>(n) * (kk / 16));
+  for (auto& x : weight) x = static_cast<uint8_t>(rng() & 0xff);
+  for (auto& x : scales) x = static_cast<uint8_t>(0x30 | (rng() & 0x07));
+}
+
+int main(int argc, char** argv) {
+  bool do_transpose = false, do_store = false, do_korder = false, do_gemm = false;
+  for (int i = 1; i < argc; ++i) {
+    if (!std::strcmp(argv[i], "--smoke")) {
+      do_transpose = do_store = do_korder = do_gemm = true;
+    } else if (!std::strcmp(argv[i], "--transpose")) do_transpose = true;
+    else if (!std::strcmp(argv[i], "--store")) do_store = true;
+    else if (!std::strcmp(argv[i], "--korder")) do_korder = true;
+    else if (!std::strcmp(argv[i], "--gemm")) do_gemm = true;
+  }
+  if (!(do_transpose || do_store || do_korder || do_gemm)) {
+    std::printf("usage: %s [--smoke|--transpose|--store|--korder|--gemm]\n", argv[0]);
+    return 2;
+  }
+
+  const int n = kCtaN, k = kCtaK, groups = k / 16;
+  std::vector<uint8_t> weight, scales;
+  fill_inputs(weight, scales, n, k);
+  const qpn2_test::Packed packed = qpn2_test::repack(weight, scales, n, k);
+  const float gscale = 0.75f;
+
+  uint8_t* d_qpn2 = nullptr;
+  __half* d_ref = nullptr;
+  __half* d_out = nullptr;
+  CUDA_CHECK(cudaMalloc(&d_qpn2, packed.bytes.size()));
+  CUDA_CHECK(cudaMalloc(&d_ref, sizeof(__half) * k * n));
+  CUDA_CHECK(cudaMalloc(&d_out, sizeof(__half) * k * n));
+  CUDA_CHECK(cudaMemcpy(d_qpn2, packed.bytes.data(), packed.bytes.size(), cudaMemcpyHostToDevice));
+
+  int failures = 0;
+  reference_kernel<<<(k * n + 255) / 256, 256>>>(d_qpn2, groups, gscale, d_ref, k, n);
+  transpose_kernel<<<1, kThreads>>>(d_qpn2, groups, gscale, d_out);
+  CUDA_CHECK(cudaDeviceSynchronize());
+
+  std::vector<__half> host_ref(static_cast<size_t>(k) * n);
+  std::vector<__half> host_out(static_cast<size_t>(k) * n);
+  CUDA_CHECK(cudaMemcpy(host_ref.data(), d_ref, sizeof(__half) * k * n, cudaMemcpyDeviceToHost));
+  CUDA_CHECK(cudaMemcpy(host_out.data(), d_out, sizeof(__half) * k * n, cudaMemcpyDeviceToHost));
+
+  if (do_transpose) {
+    const int bad = std::memcmp(host_ref.data(), host_out.data(), sizeof(__half) * k * n) != 0;
+    std::printf("transpose: %s (byte-for-byte vs reference, %d x %d)\n",
+                bad ? "MISMATCH" : "ok", k, n);
+    failures += bad;
+  }
+
+  if (do_store) {
+    __half* d_tile = nullptr;
+    CUDA_CHECK(cudaMalloc(&d_tile, sizeof(__half) * k * n));
+    CUDA_CHECK(cudaMemset(d_tile, 0, sizeof(__half) * k * n));
+    store_kernel<<<1, kThreads>>>(d_qpn2, groups, gscale, d_tile);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    std::vector<__half> host_tile(static_cast<size_t>(k) * n);
+    CUDA_CHECK(cudaMemcpy(host_tile.data(), d_tile, sizeof(__half) * k * n,
+                          cudaMemcpyDeviceToHost));
+    LayoutB layout(n);
+    int bad = 0;
+    for (int kk = 0; kk < k; ++kk) {
+      for (int nn = 0; nn < n; ++nn) {
+        const int64_t off = layout(cutlass::MatrixCoord(kk, nn));
+        if (std::memcmp(&host_tile[off], &host_ref[kk * n + nn], sizeof(__half))) ++bad;
+      }
+    }
+    std::printf("store: %s (layout read-back vs reference, %d mismatches)\n",
+                bad ? "MISMATCH" : "ok", bad);
+    failures += bad != 0;
+    cudaFree(d_tile);
+  }
+
+  if (do_korder) {
+    // A is a delta matrix: C[m][n] must equal B[k0][n] for every k0.
+    std::vector<__half> host_a(static_cast<size_t>(kM) * k);
+    std::vector<float> host_c(static_cast<size_t>(kM) * n);
+    __half *d_a = nullptr;
+    float* d_c = nullptr;
+    CUDA_CHECK(cudaMalloc(&d_a, sizeof(__half) * kM * k));
+    CUDA_CHECK(cudaMalloc(&d_c, sizeof(float) * kM * n));
+    int bad = 0;
+    for (int k0 = 0; k0 < k; ++k0) {
+      for (int m = 0; m < kM; ++m)
+        for (int kk = 0; kk < k; ++kk) host_a[m * k + kk] = __float2half(kk == k0 ? 1.0f : 0.0f);
+      CUDA_CHECK(cudaMemcpy(d_a, host_a.data(), sizeof(__half) * kM * k, cudaMemcpyHostToDevice));
+      gemm_kernel<<<(kM * n + 255) / 256, 256>>>(d_a, d_out, d_c, kM, n, k);
+      CUDA_CHECK(cudaDeviceSynchronize());
+      CUDA_CHECK(cudaMemcpy(host_c.data(), d_c, sizeof(float) * kM * n, cudaMemcpyDeviceToHost));
+      for (int m = 0; m < kM; ++m)
+        for (int nn = 0; nn < n; ++nn)
+          if (host_c[m * n + nn] != __half2float(host_out[k0 * n + nn])) ++bad;
+    }
+    std::printf("korder: %s (delta-A M=%d, %d mismatches)\n", bad ? "MISMATCH" : "ok", kM, bad);
+    failures += bad != 0;
+    cudaFree(d_a);
+    cudaFree(d_c);
+  }
+
+  if (do_gemm) {
+    std::vector<__half> host_a(static_cast<size_t>(kM) * k);
+    std::mt19937 rng(7);
+    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
+    for (auto& x : host_a) x = __float2half(dist(rng));
+    __half* d_a = nullptr;
+    float* d_c = nullptr;
+    CUDA_CHECK(cudaMalloc(&d_a, sizeof(__half) * kM * k));
+    CUDA_CHECK(cudaMalloc(&d_c, sizeof(float) * kM * n));
+    CUDA_CHECK(cudaMemcpy(d_a, host_a.data(), sizeof(__half) * kM * k, cudaMemcpyHostToDevice));
+    gemm_kernel<<<(kM * n + 255) / 256, 256>>>(d_a, d_out, d_c, kM, n, k);
+    CUDA_CHECK(cudaDeviceSynchronize());
+    std::vector<float> host_c(static_cast<size_t>(kM) * n);
+    CUDA_CHECK(cudaMemcpy(host_c.data(), d_c, sizeof(float) * kM * n, cudaMemcpyDeviceToHost));
+    double worst = 0.0;
+    for (int m = 0; m < kM; ++m) {
+      for (int nn = 0; nn < n; ++nn) {
+        double ref = 0.0;
+        for (int kk = 0; kk < k; ++kk) {
+          ref += __half2float(host_a[m * k + kk]) * q::value_at(packed.bytes.data(), kk, nn, groups, gscale);
+        }
+        const double denom = std::max(1e-6, std::fabs(ref));
+        worst = std::max(worst, std::fabs(host_c[m * n + nn] - ref) / denom);
+      }
+    }
+    const bool bad = worst > 1e-3;
+    std::printf("gemm: %s (M=%d, worst relative %.3e)\n", bad ? "MISMATCH" : "ok", kM, worst);
+    failures += bad;
+    cudaFree(d_a);
+    cudaFree(d_c);
+  }
+
+  cudaFree(d_qpn2);
+  cudaFree(d_ref);
+  cudaFree(d_out);
+  std::printf(failures ? "FAILED\n" : "OK\n");
+  return failures ? 1 : 0;
+}
